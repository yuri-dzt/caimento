# ---- App ----
NODE_ENV=development
PORT=3333
VITE_DEV_PORT=5173
APP_TIMEZONE=America/Sao_Paulo
# Origem do front em dev (em produção é same-origin, pode ficar vazio)
CORS_ORIGIN=http://localhost:5173
# Segredo para assinar URLs de arquivo (min 32 chars)
APP_SECRET=troque_por_um_segredo_aleatorio_de_32_chars_ou_mais
FILE_URL_TTL_SECONDS=3600
MAX_UPLOAD_MB=10

# ---- Auth (login local) ----
JWT_SECRET=troque_por_outro_segredo_aleatorio_de_32_chars_ou_mais
JWT_EXPIRES_IN=7d

# ---- Banco (MySQL) ----
DATABASE_URL=mysql://root:root@localhost:3306/caimento

# ---- Storage (MinIO) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=caimento
MINIO_REGION=us-east-1

# ---- IA de imagem ----
# openai (padrão) ou gemini
IMAGE_PROVIDER=openai

# OpenAI (endpoint de edição de imagem, aceita várias fotos de entrada)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high | auto (quanto maior, mais caro e mais lento)
OPENAI_IMAGE_QUALITY=medium
# 1024x1536 = retrato (roupa inteira)
OPENAI_IMAGE_SIZE=1024x1536
# high preserva rosto e detalhes das fotos (importante no provador); vazio = padrão do modelo
OPENAI_INPUT_FIDELITY=high

# Google Gemini (alternativa, só se IMAGE_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Simulações processadas em paralelo
SIMULATION_CONCURRENCY=2
# Tempo máximo de uma geração (ms). Qualidade high da OpenAI pode passar de 1 minuto.
SIMULATION_TIMEOUT_MS=180000

# ---- Seed (primeiro admin da plataforma) ----
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@caimento.local
ADMIN_PASSWORD=troque_esta_senha
